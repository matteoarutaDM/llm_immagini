# Copia questo file in .env e personalizza i valori per il tuo ambiente.
# Non committare mai .env con segreti reali.

# ==================================================
# Database PostgreSQL
# ==================================================
# postgresql://utente:password@host:porta/database
# Al primo avvio il backend applica database/schema.sql se il DB è vuoto.
# Per copiare i dati dal vecchio SQLite: .venv/bin/python database/migrate_from_sqlite.py
DATABASE_URL=postgresql://postgres@localhost:5432/assistente
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# I test usano un database separato che viene ricreato a ogni esecuzione (deve finire con _test).
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/assistente_test

# ==================================================
# Autenticazione / sessione
# ==================================================
APP_ENV=development
# Obbligatoria quando APP_ENV=production; se assente in sviluppo viene
# generato un segreto casuale ad ogni riavvio (tutte le sessioni scadono).
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# ==================================================
# 2FA (codice a 6 cifre via email)
# ==================================================
TWO_FA_CHALLENGE_TTL_SECONDS=300
TWO_FA_EMAIL_CODE_TTL_SECONDS=600

# ==================================================
# Reset password
# ==================================================
# Base URL del frontend, usata per costruire il link nell'email di reset
# (FRONTEND_URL/reset-password?token=...).
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# ==================================================
# Email (SMTP) — usato per l'email di reset password
# ==================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@assistente-macchine.local
SMTP_FROM_NAME=Assistente Macchine
SMTP_USE_TLS=true

# Solo sviluppo locale, MAI in produzione: se SMTP non è configurato, logga
# il link di reset invece di limitarsi a dire che un'email è stata "inviata",
# cosi' il flusso resta testabile end-to-end senza un vero server SMTP.
DEBUG_EMAIL_TOKENS=false

# ==================================================
# Rete / rate limiting
# ==================================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_ASK_MAX=20
RATE_LIMIT_ASK_WINDOW_SECONDS=60
RATE_LIMIT_2FA_MAX=10
RATE_LIMIT_2FA_WINDOW_SECONDS=300
RATE_LIMIT_2FA_SEND_MAX=5
RATE_LIMIT_2FA_SEND_WINDOW_SECONDS=300
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=300

# ==================================================
# Frontend (Next.js) — proxy verso il backend FastAPI
# ==================================================
BACKEND_URL=http://127.0.0.1:8000
# Segreto condiviso backoffice → backend per le operazioni interne (es. eliminare
# documenti). Stesso valore letto da FastAPI e da Next.js; vuoto = disattivate.
# Generalo con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BACKOFFICE_API_TOKEN=
# Attesa massima per un'analisi foto+domanda (/api/ask). 0 = nessun limite.
ASK_TIMEOUT_SECONDS=1800

# ==================================================
# Backoffice operatori (/admin)
# ==================================================
# "mock" = operatori di sviluppo + dati simulati in memoria (default in dev).
# In produzione il default è "backend": finché i servizi reali non sono
# collegati (app/admin/_server/services), login e API rispondono 503.
BACKOFFICE_DATA_SOURCE=mock
# Password degli operatori mock (admin@backoffice.local / support@backoffice.local).
BACKOFFICE_DEV_ADMIN_PASSWORD=Admin!2026
BACKOFFICE_DEV_SUPPORT_PASSWORD=Support!2026
BACKOFFICE_SESSION_TTL_SECONDS=28800
BACKOFFICE_OTP_TTL_SECONDS=300
BACKOFFICE_LOGIN_MAX_ATTEMPTS=8
