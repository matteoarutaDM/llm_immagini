# Copia questo file in .env e personalizza i valori per il tuo ambiente.
# Non committare mai .env con segreti reali.

# ==================================================
# Database PostgreSQL
# ==================================================
# postgresql://utente:password@host:porta/database
# Al primo avvio il backend applica database/schema.sql se il DB è vuoto.
# Per copiare i dati dal vecchio SQLite: .venv/bin/python database/migrate_from_sqlite.py
DATABASE_URL=postgresql://postgres@localhost:5432/assistente
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# I test usano un database separato che viene ricreato a ogni esecuzione (deve finire con _test).
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/assistente_test

# ==================================================
# Autenticazione / sessione
# ==================================================
APP_ENV=development
# Obbligatoria quando APP_ENV=production; se assente in sviluppo viene
# generato un segreto casuale ad ogni riavvio (tutte le sessioni scadono).
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# ==================================================
# 2FA (codice a 6 cifre via email)
# ==================================================
TWO_FA_CHALLENGE_TTL_SECONDS=300
TWO_FA_EMAIL_CODE_TTL_SECONDS=600

# ==================================================
# Reset password
# ==================================================
# Base URL del frontend, usata per costruire il link nell'email di reset
# (FRONTEND_URL/reset-password?token=...).
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# ==================================================
# Email (SMTP) — usato per l'email di reset password
# ==================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@assistente-macchine.local
SMTP_FROM_NAME=Assistente Macchine
SMTP_USE_TLS=true

# Solo sviluppo locale, MAI in produzione: se SMTP non è configurato, logga
# il link di reset invece di limitarsi a dire che un'email è stata "inviata",
# cosi' il flusso resta testabile end-to-end senza un vero server SMTP.
DEBUG_EMAIL_TOKENS=false

# ==================================================
# Rete / rate limiting
# ==================================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_ASK_MAX=20
RATE_LIMIT_ASK_WINDOW_SECONDS=60
RATE_LIMIT_2FA_MAX=10
RATE_LIMIT_2FA_WINDOW_SECONDS=300
RATE_LIMIT_2FA_SEND_MAX=5
RATE_LIMIT_2FA_SEND_WINDOW_SECONDS=300
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=300

# ==================================================
# Modello linguistico (Ollama, locale o remoto)
# ==================================================
# Usato solo dal backend: il frontend non conosce mai questo indirizzo.
# Locale:                      http://localhost:11434
# PC GPU remoto via Tailscale: http://100.x.x.x:11434  oppure  http://server-ai:11434
OLLAMA_BASE_URL=http://100.x.x.x:11434
OLLAMA_MODEL=llama3.1:8b
# Secondi di attesa della risposta completa del modello.
OLLAMA_TIMEOUT=120
# Secondi per aprire la connessione (PC spento = errore dopo questo tempo).
OLLAMA_CONNECT_TIMEOUT=10
# Facoltativo: finestra di contesto in token. Vuoto = default del modello.
# OLLAMA_NUM_CTX=8192
# Consigliato: massimo di token generati per risposta, ferma il modello se entra in un ciclo.
OLLAMA_NUM_PREDICT=1024
# Facoltativo: quanto resta il modello nella VRAM dopo una domanda ("30m", -1 = sempre).
# Vuoto = default di Ollama (5 minuti).
# OLLAMA_KEEP_ALIVE=30m
# Facoltativi, solo con OCR_BACKEND diverso da "got": modello multimodale per la targhetta.
# VISION_LLM_MODEL=llama3.2-vision
# VISION_LLM_BASE_URL=http://100.x.x.x:11434
# Compatibilità: se OLLAMA_BASE_URL / OLLAMA_MODEL non sono impostate, valgono
# ancora OPENAI_BASE_URL (es. http://localhost:11434/v1) e LLM_MODEL.

# ==================================================
# Fallback LLM su Modal (vedi README, "LLM fallback: RTX 5090 -> Modal")
# ==================================================
# ---------------------------------------------------------------- Fallback LLM su Modal
# Primario sempre: Ollama sulla RTX 5090. Modal viene chiamato SOLO se il primario
# non e' raggiungibile (PC spento, Tailscale giu', timeout, 502/503/504, modello mancante).
# true solo dopo aver fatto il deploy di deploy/modal_app.py e compilato URL e chiave.
LLM_FALLBACK_ENABLED=false
# URL dell'app Modal, senza /v1 (es. https://<workspace>--assistente-llm-fallback-serve.modal.run)
MODAL_BASE_URL=
# Stesso valore di VLLM_API_KEY nel secret Modal "assistente-llm-fallback". Mai nel frontend.
MODAL_API_KEY=
MODAL_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Include l'avvio a freddo della GPU su Modal (~2 minuti dopo una pausa): con 120 la prima risposta andava in timeout.
MODAL_TIMEOUT=300
MODAL_CONNECT_TIMEOUT=10
# Tetto alle richieste Modal contemporanee da questo backend (controllo dei costi).
MODAL_MAX_CONCURRENT_REQUESTS=2
# Circuit breaker: dopo N errori infrastrutturali di fila salta la RTX 5090 per N secondi.
LLM_PRIMARY_FAILURE_THRESHOLD=3
LLM_PRIMARY_COOLDOWN_SECONDS=60

# ==================================================
# Prestazioni pipeline immagine
# ==================================================
# 1 = carica i modelli (SigLIP, embedding, FAISS, GOT-OCR) in background all'avvio.
PRELOAD_MODELS=0
# 1 = GOT-OCR resta caricato nel processo del backend; 0 = vecchio subprocess per ogni domanda.
OCR_IN_PROCESS=1
# Foto recenti di cui tenere in memoria il testo OCR (stessa foto, più domande). 0 = disattivata.
OCR_CACHE_SIZE=32

# ==================================================
# Frontend (Next.js) — proxy verso il backend FastAPI
# ==================================================
BACKEND_URL=http://127.0.0.1:8000
# Segreto condiviso backoffice → backend per le operazioni interne (es. eliminare
# documenti). Stesso valore letto da FastAPI e da Next.js; vuoto = disattivate.
# Generalo con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BACKOFFICE_API_TOKEN=
# Attesa massima per un'analisi foto+domanda (/api/ask). 0 = nessun limite.
ASK_TIMEOUT_SECONDS=1800

# ==================================================
# Backoffice operatori (/admin)
# ==================================================
# "mock" = operatori di sviluppo + dati simulati in memoria (default in dev).
# In produzione il default è "backend": finché i servizi reali non sono
# collegati (app/admin/_server/services), login e API rispondono 503.
BACKOFFICE_DATA_SOURCE=mock
# Password degli operatori mock (admin@backoffice.local / support@backoffice.local).
BACKOFFICE_DEV_ADMIN_PASSWORD=Admin!2026
BACKOFFICE_DEV_SUPPORT_PASSWORD=Support!2026
BACKOFFICE_SESSION_TTL_SECONDS=28800
BACKOFFICE_OTP_TTL_SECONDS=300
BACKOFFICE_LOGIN_MAX_ATTEMPTS=8
