# Configurazione per `docker compose` (vedi README.md, sezione "Docker").
# Copia in .env.docker e compila. Non committare mai .env.docker: contiene segreti.
# Genera i segreti con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------- Database
POSTGRES_PASSWORD=cambia-questa-password
# Deve usare la stessa password di POSTGRES_PASSWORD.
DATABASE_URL=postgresql://assistente:cambia-questa-password@db:5432/assistente

# ---------------------------------------------------------------- Sicurezza
APP_ENV=production
AUTH_SECRET=genera-un-segreto-lungo
# Segreto condiviso backoffice → backend (eliminazione documenti).
BACKOFFICE_API_TOKEN=genera-un-altro-segreto
# Indirizzo con cui gli utenti aprono il sito (link nelle email di reset password).
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- Modello AI (Ollama)
# Ollama sul computer che esegue Docker: http://host.docker.internal:11434
# Ollama su un PC GPU remoto (Tailscale): http://100.x.x.x:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
# Breve: con il PC spento l'errore (e l'eventuale fallback) arriva dopo questo tempo.
OLLAMA_CONNECT_TIMEOUT=5
# Massimo di token generati per risposta: ferma il modello se entra in un ciclo (risposte valide: 150-400 token).
OLLAMA_NUM_PREDICT=1024
# Tiene il modello nella VRAM tra una domanda e l'altra (default di Ollama: 5m, poi ~4,5 s per ricaricarlo).
OLLAMA_KEEP_ALIVE=30m
# Carica SigLIP, embedding, FAISS e GOT-OCR all'avvio (in background) invece che alla prima domanda.
PRELOAD_MODELS=1

# ---------------------------------------------------------------- Fallback LLM su Modal
# Primario sempre: Ollama sulla RTX 5090. Modal viene chiamato SOLO se il primario
# non e' raggiungibile (PC spento, Tailscale giu', timeout, 502/503/504, modello mancante).
# true solo dopo aver fatto il deploy di deploy/modal_app.py e compilato URL e chiave.
LLM_FALLBACK_ENABLED=false
# URL dell'app Modal, senza /v1 (es. https://<workspace>--assistente-llm-fallback-serve.modal.run)
MODAL_BASE_URL=
# Stesso valore di VLLM_API_KEY nel secret Modal "assistente-llm-fallback". Mai nel frontend.
MODAL_API_KEY=
MODAL_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Include l'eventuale avvio a freddo della GPU su Modal: se la prima risposta va in timeout, alzalo.
MODAL_TIMEOUT=120
MODAL_CONNECT_TIMEOUT=10
# Tetto alle richieste Modal contemporanee da questo backend (controllo dei costi).
MODAL_MAX_CONCURRENT_REQUESTS=2
# Circuit breaker: dopo N errori infrastrutturali di fila salta la RTX 5090 per N secondi.
LLM_PRIMARY_FAILURE_THRESHOLD=3
LLM_PRIMARY_COOLDOWN_SECONDS=60
OCR_DEVICE=cpu

# ---------------------------------------------------------------- Dettatura vocale (Whisper nel backend)
# Modelli: tiny, base, small, medium, large-v3 (piu grande = piu preciso ma piu lento).
# Scaricato al primo utilizzo nel volume hf-models.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=it

# ---------------------------------------------------------------- Lettura delle risposte (Piper nel backend)
# Voce da rhasspy/piper-voices, scaricata al primo utilizzo nel volume hf-models.
# PIPER_LENGTH_SCALE: 1.0 = ritmo naturale, valori piu alti = piu lenta.
PIPER_VOICE=it_IT-paola-medium
PIPER_LENGTH_SCALE=1.05

# ---------------------------------------------------------------- Email (obbligatoria in produzione)
# Serve per la 2FA degli utenti, il reset password e il codice di accesso degli admin del backoffice.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@assistente-macchine.local
SMTP_FROM_NAME=Assistente Macchine
SMTP_USE_TLS=true
DEBUG_EMAIL_TOKENS=false

# ---------------------------------------------------------------- Limiti
MAX_UPLOAD_MB=30
MAX_AUDIO_MB=10
ASK_TIMEOUT_SECONDS=1800
