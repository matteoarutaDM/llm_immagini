# Configurazione per `docker compose` (vedi README.md, sezione "Docker").
# Copia in .env.docker e compila. Non committare mai .env.docker: contiene segreti.
# Genera i segreti con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------- Database
POSTGRES_PASSWORD=cambia-questa-password
# Deve usare la stessa password di POSTGRES_PASSWORD.
DATABASE_URL=postgresql://assistente:cambia-questa-password@db:5432/assistente

# ---------------------------------------------------------------- Sicurezza
APP_ENV=production
AUTH_SECRET=genera-un-segreto-lungo
# Segreto condiviso backoffice → backend (eliminazione documenti).
BACKOFFICE_API_TOKEN=genera-un-altro-segreto
# Indirizzo con cui gli utenti aprono il sito (link nelle email di reset password).
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- Modello AI (OVH AI Endpoints)
# Qwen3.5-9B su OVHcloud AI Endpoints: datacenter UE, pagato a token, nessun server GPU nostro.
# Chiave API: Public Cloud > progetto > AI Endpoints > API keys. Mai nel frontend.
# Senza chiave il sito parte, ma ogni domanda all'AI risponde 503.
OVH_AI_API_KEY=
OVH_AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net
OVH_AI_MODEL=Qwen3.5-9B
# Qwen3.5 "ragiona" prima di rispondere: il ragionamento si paga e consuma max_tokens,
# con il rischio di risposte vuote. none lo spegne (low/medium/high per riattivarlo).
OVH_AI_REASONING_EFFORT=none
# Massimo di token generati per risposta: ferma il modello se entra in un ciclo (risposte valide: 150-400 token).
OVH_AI_MAX_TOKENS=1024
OVH_AI_TIMEOUT=120
OVH_AI_CONNECT_TIMEOUT=10
# Tetto alle richieste OVH contemporanee da questo backend (controllo dei costi).
OVH_AI_MAX_CONCURRENT_REQUESTS=4

# Carica SigLIP, embedding, FAISS e GOT-OCR all'avvio (in background) invece che alla prima domanda.
PRELOAD_MODELS=1
OCR_DEVICE=cpu

# ---------------------------------------------------------------- Dettatura vocale (Whisper nel backend)
# Modelli: tiny, base, small, medium, large-v3 (piu grande = piu preciso ma piu lento).
# Scaricato al primo utilizzo nel volume hf-models.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=it

# ---------------------------------------------------------------- Lettura delle risposte (Piper nel backend)
# Voce da rhasspy/piper-voices, scaricata al primo utilizzo nel volume hf-models.
# PIPER_LENGTH_SCALE: 1.0 = ritmo naturale, valori piu alti = piu lenta.
PIPER_VOICE=it_IT-paola-medium
PIPER_LENGTH_SCALE=1.05

# ---------------------------------------------------------------- Email (obbligatoria in produzione)
# Serve per la 2FA degli utenti, il reset password e il codice di accesso degli admin del backoffice.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@assistente-macchine.local
SMTP_FROM_NAME=Assistente Macchine
SMTP_USE_TLS=true
DEBUG_EMAIL_TOKENS=false

# ---------------------------------------------------------------- Limiti
MAX_UPLOAD_MB=30
MAX_AUDIO_MB=10
ASK_TIMEOUT_SECONDS=1800
